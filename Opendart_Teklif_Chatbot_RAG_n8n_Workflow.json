{
  "name": "Opendart Teklif Chatbot - RTX A5000 RAG",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "web-site-teklif-chat",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "https://teklif.opendartakademi.com"
        }
      },
      "id": "2e9d4a73-08be-44aa-9d83-bf311d2db001",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-760, 0],
      "webhookId": "opendart-web-site-teklif-chat-rag"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "message", "name": "message", "value": "={{ String($json.body.message || '').trim().slice(0, 1000) }}", "type": "string" },
            { "id": "session", "name": "sessionId", "value": "={{ String($json.body.sessionId || 'anonymous').replace(/[^a-zA-Z0-9-_]/g, '').slice(0, 100) }}", "type": "string" },
            { "id": "history", "name": "history", "value": "={{ Array.isArray($json.body.history) ? $json.body.history.slice(-8).map(m => ({ role: String(m.role || '').slice(0, 20), content: String(m.content || '').slice(0, 1000) })) : [] }}", "type": "array" },
            { "id": "locale", "name": "locale", "value": "={{ String($json.body.locale || 'tr-TR').slice(0, 10) }}", "type": "string" },
            { "id": "origin", "name": "origin", "value": "={{ $json.headers.origin || '' }}", "type": "string" },
            { "id": "received", "name": "receivedAt", "value": "={{ $now.toISO() }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "c8ee9cca-4450-48c7-ac63-0e941770b002",
      "name": "İsteği Doğrula ve Sınırla",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            { "id": "valid-message", "leftValue": "={{ $json.message.length }}", "rightValue": 1, "operator": { "type": "number", "operation": "gte" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1e6225d1-a45f-4c2b-9bb4-18ed15eae003",
      "name": "Mesaj Geçerli mi?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-280, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://RAG-SUNUCU-ALAN-ADINIZ/api/v1/chat",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ query: $json.message, session_id: $json.sessionId, history: $json.history, locale: $json.locale, namespace: 'opendart-teklif', top_k: 8, rerank_top_k: 4, min_score: 0.58, include_sources: true }) }}",
        "options": {
          "timeout": 60000,
          "response": { "response": { "neverError": true, "responseFormat": "json" } }
        }
      },
      "id": "11384917-9445-4dd8-b937-50c2e12af004",
      "name": "RTX A5000 RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, -80],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { answer: $json.answer || $json.output || 'Bilgi tabanında bu soruya güvenilir bir yanıt bulamadım. Teklif formunu doldurursanız ekibimiz sizinle iletişime geçecektir.', sources: Array.isArray($json.sources) ? $json.sources.slice(0, 5) : [], suggestedQuestions: Array.isArray($json.suggested_questions) ? $json.suggested_questions.slice(0, 3) : ['Proje süreci nasıl ilerler?', 'Teklif için hangi bilgiler gerekli?'], confidence: Number($json.confidence || 0), handoff: Boolean($json.handoff || Number($json.confidence || 0) < 0.45) } }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json; charset=utf-8" },
              { "name": "Access-Control-Allow-Origin", "value": "https://teklif.opendartakademi.com" },
              { "name": "Cache-Control", "value": "no-store" }
            ]
          }
        }
      },
      "id": "9caf19e9-0129-472b-9191-a7e324347005",
      "name": "RAG Yanıtını Döndür",
      "type": "n8n-nodes-base.respondToWebhook",
